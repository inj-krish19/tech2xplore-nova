# ============================================================
# Tech2Xplore — environment variables
# Copy this to .env.local (Next.js loads that automatically,
# don't commit it — .env.local should already be in .gitignore
# by default from create-next-app)
# ============================================================

# ---------- DATABASE ----------
# [YOU WRITE] Your own Postgres connection string — same DB you
# introspected the schema from. Format:
# postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=

# ---------- AUTH.JS CORE ----------
# [YOU GENERATE] Run this locally and paste the output:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# [YOU WRITE] http://localhost:3000 for local dev.
# On Vercel, set this to your real deployed URL
# (e.g. https://tech2xplore.vercel.app) in the Vercel
# dashboard's env settings, not in this file.
NEXTAUTH_URL=http://localhost:3000

# ---------- EMAIL VERIFICATION (magic link) ----------
# [YOU GENERATE] Optional but recommended — a second secret so this
# token's signing key is independent of NEXTAUTH_SECRET. Same command:
#   openssl rand -base64 32
# If left blank, the code falls back to reusing NEXTAUTH_SECRET.
EMAIL_VERIFICATION_SECRET=

# ---------- EMAIL SENDING (Nodemailer via Gmail, for now) ----------
# [YOU WRITE] Your own Gmail address.
GMAIL_USER=

# [FROM EXTERNAL SITE] Google Account -> Security -> 2-Step
# Verification must be ON first, then generate at:
#   https://myaccount.google.com/apppasswords
# This is NOT your normal Gmail password — it's a 16-character
# app-specific password. Paste it exactly as shown (spaces are fine,
# Google's own field includes them).
GMAIL_APP_PASSWORD=

# ---------- GOOGLE OAUTH LOGIN ----------
# [FROM EXTERNAL SITE] Google Cloud Console -> APIs & Services ->
# Credentials -> Create Credentials -> OAuth Client ID (type: Web
# application). Add this as an Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
# (and the equivalent https://<your-domain>/api/auth/callback/google
# once deployed). Copy the Client ID + Client Secret it gives you.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- LINKEDIN OAUTH LOGIN + POSTING ----------
# [FROM EXTERNAL SITE] LinkedIn Developer Portal -> your app ->
# Auth tab. Add this as an Authorized redirect URL:
#   http://localhost:3000/api/auth/callback/linkedin
# Under Products, make sure "Sign In with LinkedIn using OpenID
# Connect" AND whatever product grants w_member_social are both
# added (you said this is already approved on your end).
# https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ---------- ADMIN ACCESS (temporary stopgap — see app/admin/page.tsx) ----------
# [YOU WRITE] Comma-separated list of emails allowed into /admin.
# This is a placeholder until a real `role` column exists on
# `blogger` — flag it if you want that schema change queued up.
ADMIN_EMAILS=

# ---------- RESEND (not in use yet — deferred per your Gmail decision) ----------
# [FROM EXTERNAL SITE, WHEN YOU REVISIT THIS] resend.com — needs a
# verified sending domain. Leave blank for now; mail.ts uses
# Nodemailer/Gmail until you're ready to switch.
RESEND_API_KEY=
EMAIL_FROM=




# LinkedIn — organization-level automation (distinct from LINKEDIN_CLIENT_ID/
# SECRET, which are the per-user OAuth "Post to LinkedIn" button)
LINKEDIN_ORG_ACCESS_TOKEN=
LINKEDIN_ORG_ID=
LINKEDIN_API_VERSION=202601

# Basic Auth for the cron-triggered automation route only
LINKEDIN_AUTOMATION_USERNAME=
LINKEDIN_AUTOMATION_PASSWORD=

# News providers (technology category)
GNEWS_API_KEY=
NEWSAPI_API_KEY=
NYTIMES_API_KEY=
MEDIASTACK_API_KEY=

# Gemini — generates the LinkedIn post text from the fetched article
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PROMPT="You are a senior LinkedIn content writer with 3+ years of experience writing high-performing posts for a technical, tech-news-savvy audience. You will be given an article's description and its source link — treat that as your only factual basis; never invent details, statistics, or quotes it doesn't support. Write exactly one LinkedIn post, never multiple options, drafts, or variations to choose from. Open with a sharp, specific hook in the first line that earns a click on 'see more' — avoid generic openers like 'Big news' or 'Exciting update'. Follow with a short, eye-catching title-style line, then on its own line put only ***** to separate the title from the body. The body should read like confident, natural human writing in 2-3 short paragraphs, each no more than 3-4 lines, blending storytelling with news clarity — inform first, add perspective second, never oversell. Use emojis sparingly and only where they genuinely add a human touch or a natural pause between ideas — one or two per paragraph at most, never as bullets or decoration, never in the hashtags. Write in plain sanitized text only: no markdown, no asterisks or underscores for bold or italic, no headers, no numbered or bulleted lists, no other special formatting characters — the output must be exactly what should appear on LinkedIn, nothing to strip out. Keep the whole post well under 1500 characters total so it reads clean without LinkedIn's 'see more' cutting it off mid-thought. End with one blank line, then 3-5 specific, well-researched hashtags relevant to this article's actual topic — not generic ones like #news or #technology alone. Do not include greetings, sign-offs, filler like 'Here's a LinkedIn post:', or any explanation of what you did — output only the final ready-to-post text, starting directly with the hook line and ending with the hashtags."

# Rotation — how many articles per day-bucket, how many buckets to cycle
LINKEDIN_AUTOMATION_MAX_NEWS=3
LINKEDIN_AUTOMATION_MAX_WEIGHT_DAYS=3